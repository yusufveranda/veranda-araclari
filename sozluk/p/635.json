k yeğenime verdim.",[],[],[],[]],["Bir insan, bir hayvan veya bitkide hayatın tam ve kesin olarak sona ermesi","n",["ölüm","memat","son yolculuk","ebedî uyku","ebedi uyku","emrihak","irtihal","ahiret yolculuğu","mevt","vefat"],"Her hastalığın sonu ölüm değildir|Yaşlı köpeğimizin sonu dün gece geldi, sabaha karşı kaybettik.",["doğma","doğum","doğuş"],["organik olgu"],["bebek ölümü","kangren","son nefes","beşik ölümü","beyin ölümü","son uyku"],["açılma","çatlama","çürüme","devir","hayat","kapıcık"]],["Artık ondan ötesi veya başkası olmayan","a",["nihai"],"Son atlıkarıncayı Kadırga meydanında birkaç yıl evvel görmüştüm.|Yarışta sona kalmak hiç beklemediğim bir sonuçtu.",[],[],[],[]],["Şimdiki zamana en yakın zamandan beri olan veya bu zamanda yapılmış, olmuş olan, ilk karşıtı","a",[],"",[],[],[],[]],["En arkada bulunan","a",[],"",[],[],[],[]],["Uç; sınır","a",[],"",[],[],[],[]]],"m":[["noun",["bitimi","nihayet","etene","eş","meşime","plâsenta","olum","olanca","ahir","bitim","döl eşi","döleşi","encam","geri","hatime","hitam","hudut","intiha","münteha","nihai","payan","sınır","taze"]]],"ko":{"es":["nihayet","nihai"],"il":["önceki","ikinci","birkaç","derece","sonraki","birinci","önemli","sonuncu","beşinci","yeni","dördüncü","altıncı"],"ca":["sonunda","zorlu","sırasında","çözüm","başarılı","dakika","yeniden","başarısız","sınav","ilginç"]},"z2":["apse","asliye","dibace","giriş","hayat","kafa","kelle","mevlit"],"um":[["Umut etmek hatasında bulundum sonra\nKaburgalarım böyle eğildiler, boyum uzamayı bıraktı","Doyumsuz ve Hoyrat","https://www.birgunkarayigormekuzere.net/poems/doyumsuz-ve-hoyrat"],["Amaç beyaz, bu sefer beyaz, çünkü bu keşfimden önceki son sefer\nYakutla aramdaki son nefer","Zylphia ve Qfwfq","https://www.birgunkarayigormekuzere.net/poems/zylphia-ve-qfwfq"]],"mi":["&quot;Son zamanlarda Melih\nCevdet'i daha çok anlıyorum. (...) Senelerdir, durmadan yenilikler peşinden","Orhan Veli Kanık","Orhan Veli Kanık' In Kaleminden Melih Cevdet Anday"]},"soysuzlaşmak":{"k":[["Özündeki iyi nitelikleri birtakım dış etkenlerle zamanla yitirmek, özünden uzaklaşmak, dejenere olmak, tereddi etmek","v",["bozulmak","yozlaşmak","başkalaşmak","kötüleşmek","berbat olmak","kurulaşmak"],"Kendisine büyük hizmeti dokunmuş insanları unutmak bir toplumun yozlaştığını belgeler.|Gelenek ve değerlerden uzaklaşan toplumun soysuzlaşma süreci hızlandı.…",[],[],[],[]],["Biyolojik, toplumsal, doğal bozulmaya, dağılmaya uğramak, tefessüh etmek","v",[],"",[],[],[],[]]],"m":[["noun",["biyolojik","toplumsal","bozulmak","yozlaşmak","dejenere olmak","dejenereleşmek","tereddi etmek"]]],"z2":["durmak"]},"sözbilim":{"m":[["noun",["belagat","ilmi belagat"]]]},"su böceği":{"k":[["Kın kanatlılardan, küçük su birikintilerinde yaşayan, 18 milimetre uzunluğunda kahverengi bir böcek, hidrofil","n",[],"",[],["kın kanatlılar"],[],[]]]},"sukeleri":{"k":[["Kurbağagillerden, durgun sularda ve karada yaşayan bir tür küçük hayvan","n",["su keleri"],"",[],["Amphibia sınıfı"],[],["ağaç kurbağası","ayaksızlar","denizkızı","kurbağa","semender","semendergiller"]]]},"şuursuzlaşmak":{"k":[["Bilincini yitirmek, bilinçsiz bir duruma gelmek","v",["bilinçsizleşmek"],"",[],[],[],[]]]},"tadilat yapmak":{"k":[["Başka bir biçime sokmak, değişikliğe uğratmak","v",["değiştirmek","değişiklik yapmak","değişmek","tadil etmek","tebdil etmek","trampa etmek","ters yüz etmek"],"Rüzgâr gibi çarçabuk esiş istikametlerini değiştiriyorlar, ağaç kurdu gibi renkten renge giriyorlar.",[],[],["alışmak","allak bullak etmek","ayarlamak","beslemek","biçimsizleşmek","kuvvetlendirmek"],[]]],"z2":["durmak","kalmak"]},"talimar":{"k":[["Baş bodoslamasından omurgaya kadar uzanan, cıvadra donanımına desteklik etmek amacıyla konulan ekleme","n",[],"",[],["dahil etme"],[],["ilave etme"]]]},"tefarik":{"k":[["60-100 cm yüksekliğinde, büyük yapraklı ve beyaz çiçekli bir bitki","n",[],"",[],["bitki"],[],[]]]},"tetkik etmek":{"k":[["Bir işi veya bir şeyi ele alıp özelliklerini, ayrıntılarını inceden inceye, özenle anlamaya, öğrenmeye çalışmak","v",["araştırmak","eşmek","etüt etmek","gözlemek","kaşımak","kritik etmek","muayene etmek","incelemek","irdelemek","izlemek"],"Bu dosyayı yanıma alıp uzun uzun incelemeliyim .|Arkeologlar, kazı alanındaki her taşı dikkatle gözleyerek tarihi kalıntıların özelliklerini anlamaya çalıştı…",[],[],[],[]],["Araştırmak","v",["deşelemek","taharri etmek"],"Darvin , nevilerin değişebilme kabiliyetlerinin sebeplerini tetkik etmiştir .|Bu, biraz da ihtiyarı deşelemek, o profesör hakkında bildiklerini söyletmek içi…",[],[],[],[]]],"m":[["noun",["incelemek","araştırmak"]]]},"toplanık":{"k":[["Toplantı durumunda bulunan","a",[],"",[],[],[],[]]]},"tövbesini bozmak":{"k":[["Tövbe ettiği herhangi bir işe, duruma yeniden dönmek","v",[],"",[],[],[],[]]]},"türkoloji":{"k":[["Türk dili, tarihi, edebiyatı ve halk bilimi araştırmalarını konu edinen bilim dalı","n",["türklük bilimi","Türkiyat","Türklük bilgisi"],"",[],["bilim"],[],[]]],"m":[["noun",["tarihi","türkiyat","türklük bilgisi"]]],"ko":{"es":["şarkiyat","dilcilik","şarkiyatçılık"],"il":["filoloji","sinoloji","etnoloji","diyalektoloji","kozmoğrafya","paleografi","kozmografya","dilbilim","şarkiyatçı","etnografya","ruhiyat","edebiyat"],"ca":["cihat","kartografya","geriatri","sömürgecilik","göstergebilim","nükteci","lezbiyenlik","sinirbilimi","hikayecilik","meslekî"]}},"uçarılık":{"k":[["Hoppa olma durumu veya hoppaca davranış","n",["hoppalık","havailik"],"Selim de mutat soğukkanlılığına rağmen hoppalıklar yapıyordu.",["ciddilik","ağırbaşlılık","ciddiyet"],["nitelik"],[],[]]],"m":[["noun",["sefahat","havaîlik"]]],"ko":{"il":["sayrılık","gamsızlık","çocuksuluk","kavgacılık","neşesizlik","romantiklik","sevimsizlik","bencilik","esriklik","yırtıcılık","umarsızlık","tasasızlık"],"ca":["ferdiyetçi","bireyci","erotizm","bedahet","kutsallaştırma","tahripkar","pesimizm","fevkaladelik","hükümsüzlük","serüvenci"]},"z2":["boyun","gravite","kalın","külfet","mesuliyet","mezuniyet","salahiyet","salâhiyet"]},"uzatmayalım":{"k":[["Kısa sö