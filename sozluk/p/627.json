ndan saklanan, duyurulmayan, saklı kalan","a",["gizli"],"Müdür, dosyadan başka bir rapor çıkardı. Kenarında kırmızı bir damga: Mahrem.|Biz onunla yıllardır tanışıyoruz, benden sakladığı gizli kapaklı ne işleri olab…",[],[],[],[]],["Birinin sırlarını bilen kimse","n",["sırdaş","cankulağı"],"Az vakitte mahremlerimden biri oldu.",[],["dert ortağı"],[],["dert ortağı"]],["Yakın akrabadan olduğu için nikâh düşmeyen kimse","a",[],"",[],[],[],[]]],"m":[["noun",["gizli","sırdaş"]]],"ko":{"es":["namahrem","gizli"],"il":["imam"],"ca":["yetimlik","hanımefendi","selatin","şahsî","aidiyet","nezarethane","nikahlı"]},"z2":["aktüel","aleni","açık","aşikar","edimsel","fiili","fiilî","görünür"],"mi":["Dolaşsın, sonra, İslâm'ın harem-gâhında nâ-mahrem...\nBenim hakkım, sus ey bülbül, senin hakkın değil mâtem! (*)","Mehmet Akif Ersoy","Bülbül"]},"marmara denizi":{"k":[["Türkiye'nin kuzeybatısında bulunan Karadeniz'i, Ege ve Akdeniz'e bağlayan bir iç deniz","n",[],"",[],[],[],[]]]},"marnlamak":{"k":[["Kireci az olan toprağın içine marn katarak daha iyi duruma getirmek","v",[],"",[],[],[],[]]]},"mostra":{"k":[["Resim, heykel vb. şeyler yapılırken baka baka benzetilmeye çalışılan nesne veya kimse, örnek","n",["model"],"Bu kız akademide model olarak çalışıyor.",[],["yardımcı"],[],[]]],"m":[["noun",["örnek","göstermelik","model"]]],"ko":{"il":["kuvarsit","karst","fosilli","stratigrafi","lostra","diyabaz","litoloji","dikit","litolojik","gnays","peneplen","kumtaşı"],"ca":["lando","atelye","bağcıksız","yarlık","amfiteatr"]},"z2":["kopya"]},"müennes":{"k":[["Bazı dillerde dişi cinsten sayılan kelime","a",["dişil"],"",[],[],[],[]]],"m":[["noun",["dişil"]]],"ko":{"es":["meful","fâil","nekre","fetha","zamir","edatlı","mevsuf","şedde","ötre","dişil"],"il":["esre","lafzî","müzekker","lafzen","müşebbeh","munfasıl","hemze","lafız","çoğul","müşabih","müteradif","izafet"],"ca":["akılsal","cemâl","ifrağ","mübrem","kamerî","anlamdaş","butlan","dedüksiyon","müseccel","kafiyeli"]}},"müzminleştirme":{"k":[["M