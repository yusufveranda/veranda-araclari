et","toldı"]]],"ko":{"es":["büyüklük","cesamet"],"il":["dirilik","sivrilik","narinlik","sululuk","işleklik","sertlik","kesafet","olgunluk","cüsse","cinslik","incelik","türdeşlik"],"ca":["tortul","dereceli","simetri","tremolit","alyuvar","oylum","ebat","eşitsizlik","kapalılık","yoğunluk"]}},"işgüzarca":{"k":[["İşgüzar bir biçimde, işgüzara yakışır durumda olarak","b",[],"",[],[],[],[]]]},"işi anlamak":{"k":[["Gizli bir şeyi, bir sorunu anlamak","v",[],"",[],[],[],[]]]},"itici":{"k":[["Benimsenilmeyen, sevilmeyen, beğenilmeyen, saygı uyandırmayan","a",["antipatik","soğuk","sevimsiz","nursuz"],"Bu soğuk, yavan sözler zevkimi rencide ediyordu.|Sevimsiz bir üslupla konuştuğu için çevresindekileri rahatsız etti.|Yeni müdür, çalışanlar arasında soğuk ka…",[],[],[],[]],["İtme işini yapan","a",[],"",[],[],[],[]]],"m":[["noun",["soğuk","benimsenilmeyen","sevimsiz","sevilmeyen","beğenilmeyen","antipatik"]]],"ko":{"es":["antipatik","sevimsiz"],"il":["çekici","erkeksi","güç","sempatik","tiksindirici","tuhaf","sinirlendirici","korkutucu","zorlayıcı","garip","karizmatik","havalı"],"ca":["nursuz","komplike","nevrotik","ezici","bunaltıcı","patetik","görgüsüzce","yaltakçı","kasvetli","devingenlik"]},"z2":["cana yakın","içten","sıcak"]},"iyiliğe iyilik olsaydı, koca öküze bıçak olmazdı":{"m":[["noun",["öküz"]]]},"kalandır":{"k":[["Dokunmuş kumaş ve bezleri buhar altında veya belli bir ısıda silindir arasından geçirerek ütüleme, parlatma, istenilen boy ve ene göre çektirip germe","n",[],"",[],["iş"],[],[]]],"m":[["noun",["parlatma"]]],"ko":{"il":["kalırsa","kalsa","kalmalı"]}},"kaymaoluşum":{"m":[["noun",["tektonik"]]]},"kazığa oturtmak":{"k":[["Bir kimseyi yere dikilmiş ucu sivri bir kazığa oturtarak öldürmek","v",["kazığa vurmak"],"Münasebetsizliklerine mukabele edeni ihtimal kazığa vuracak, derisini yüzecek, akla gelmedik kaba bir vahşetle öldürecekti.",[],["öldürmek"],[],[]]]},"kılgı":{"k":[["Bir sanat ve bilim dalının ilkelerini düşünce alanından uygulama alanına geçirip gerçekleş