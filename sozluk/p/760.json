{"w":{"abbas":{"k":[["\"Yola çıkacak kimse\" anlamındaki Abbas yolcu deyiminde geçen bir söz","n",[],"",[],["karakter"],[],["balama","başkahraman","başkarakter","Beberuhi","Kavuklu","Keloğlan"]]],"ko":{"il":["cemil","gökmen","tarık","sami","süheyl","böke","turgay","dilaver","erbakan","gaffar","haluk","agah"],"ca":["martin","mardin","rambo","bibi","kâzım","karayılan","civanım","şöför","kavaf"]},"mi":["Haydi Abbas, vakit tamam;\nAkşam diyordun işte oldu akşam.","Cahit Sıtkı Tarancı","Abbas"]},"ad bilimi":{"k":[["Dil biliminin adlar, özellikle kişi adları üzerinde duran ve onları köken bilgisi, tarihsel gelişme, dil ve kültür sorunları açısından inceleyen dalı","n",["adbilim"],"",[],["dilbilim"],[],[]]]},"ağa":{"k":[["Büyük erkek kardeş","n",["abi","ağabey","efe","aka","ede"],"Köye varınca ağamdan parasını muhakkak alır, sana veririm.",[],["erkek kardeş"],[],[]],["Bir kadının evlenmiş olduğu erkek","n",["erkek","koca","efendi","eloğlu","er","refik","zevç","ayvaz"],"Bütün kadınlar gibi aklınca bu yolla kocasını zevksizlikle suçluyordu.|Davette, dostlarıyla birlikte refikini tanıştırmaktan büyük mutluluk duydu.",["karı","avrat","hatun"],["erkek","eş"],["geyik","kerata"],[]],["Geniş toprakları olan, sözü geçen, varlıklı kimse","n",[],"",[],["birey"],["köy ağası"],[]],["Halk arasında sayılan ve sözü geçen erkeklere verilen unvan","n",[],"",[],["unvan"],[],[]],["Okur yazar olmayan yaşlıca kişilerin adlarıyla birlikte kullanılan san","n",[],"",[],["unvan"],[],[]],["Osmanlı İmparatorluğunda bazı kuruluşların başında bulunanlara verilen resmî san","n",[],"",[],["unvan"],["kapı ağası","kızlar ağası","paşalı"],[]]],"m":[["noun",["koca","cömert","ağabey","aga","hâce"]]],"ko":{"il":["ağın","sekbanbaşı","ırgat","ağı","dayı","ağababa","horhor","maraba"],"ca":["dut","fidan","badem","çam","tohum","erik","ekin","çayır","bostan","yaban"]},"z2":["aile","arsız","ayal","bayan","cinsilatif","dişi","eksik etek","eksikli"],"um":[["Demiri kızıl, ağacı bodur, zifti kurumuş baştan\nGöğün cevherine kadar öğrenilmemeliydi","Göğükesen","https://www.birgunkarayigormekuzere.net/poems/g%C3%B6%C4%9F%C3%BCkesen"]]},"ağızsıl ünlü":{"k":[["Boğumlanma yeri ağız olan ve burun yolu kapalı iken çıkarılan ünlü","n",["ağız ünlüsü"],"",[],["sesli harf"],[],[]]],"m":[["noun",["ağız ünlüsü"]]]},"akyıldız":{"m":[["noun",["çobanyıldızı","zühre","çulpan","çolpan"]]]},"ambalaj malzemesi":{"k":[["Ambalajlama işinde kullanılan malzeme","n",[],"",[],["malzeme"],["karton","mukavva"],[]]]},"anglikanizm":{"k":[["İngiliz kilisesinin tuttuğu inanç yolu","n",[],"",[],["Protestanlık"],[],["Kalvenizm","presbiteryenlik"]]]},"arılaştırma":{"k":[["Bir dili yabancı ögelerden arıtarak arı, katışıksız bir duruma getirmeyi ve kendi imkânlarıyla geliştirmeyi amaçlayan çalışmalar yapma","n",["tasfiye","özleştirme"],"Dilde tasfiye.",[],["yükümlülük"],[],["besleme","görev","vazife","mali yükümlülük","obligasyon"]]],"m":[["noun",["özleştirme"]]],"ko":{"il":["batılılaştırma","melezleştirme","çağdaşlaştırma","ehlileştirme","kutsallaştırma","tasfiyecilik","ilahlaştırma","sembolleştirme","arı","eleştiricilik","kişileştirme","modernleştirme"],"ca":["ağlayıcı","referandum","kartografi","doğmaca","ırgatlık","kartografya","nükteci","teşhircilik","oğlancılık","fizikokimya"]}},"art damak":{"k":[["Damağın arka bölümü","n",["artdamak"],"",[],["damak"],[],["alt damak","damak eteği","ön damak","yumuşak damak"]]]},"beşon":{"k":[["Beş ve on cm ölçülerinde biçilmiş kereste","n",[],"",[],["tahta"],[],[]]]},"bir kafada":{"k":[["Aynı düşüncede olan kimse","n",[],"",[],["insan"],[],[]]]},"bölümlendirme":{"k":[["Karşılaştırma esasına bağlı olarak tasnif yapmak eylemi","n",["sınıflandırma"],"Kitapların daha düzenli olması için bir sınıflandırma sistemi geliştirdik.",[],["sınıflama"],["bölümlenme","endeksleme"],["tipolojik tasnif"]]],"m":[["noun",["sınıflandırma"]]]},"çarkıfelek":{"k":[["Bütün olayları önceden ve değişmeyecek biçimde düzenlediğine inanılan doğaüstü güç","n",["kader","alın yazısı","ezeli takdir","ezelî takdir","fatalite","hayat","kader çizgisi","mukadderat","takdir","takdiriilahi","takdiriilahî","tecelli","yazgı","yazı","alınyazısı","baht","devlet","devran","felek","kısmet","nasip","şans","sur","talih","uğur","yıldız"],"Kahpe felek kimine kavun yedirir, kimine kelek.|Birçok kişi, yaşanan her şeyin bir şekilde hayat denilen gizemli bir güç tarafından önceden yazıldığına inanı…",[],["doğaüstü varlık"],["benzemez","beş bir","beş dört","beş iki","bir bir","ciharıdü"],["abıkevser","abıhayat","çöpçatan","Deccal","Yaradan","hayalet"]],["Çarkıfelekgillerden, güzel, büyük, parlak kırmızı çiçekleri olan, duvar kenarlarına ve kameriyeler çevresine ekilen tırmanıcı bir süs bitkisi","n",["fırıldak çiçeği","fırıldakçiçeği","saat çiçeği"],"Bahçedeki çarkıfelekler, yaz boyunca göz alıcı renkleriyle etrafı süsledi.",[],["çarkıfelekgiller"],[],[]],["Yakıldığında dönerek kıvılcım saçan donanma fişeği","n",[],"",[],["havai fişek"],[],["maytap"]],["Bir tür talih oyunu","n",[],"",[],["şans oyunu"],[],[]]],"m":[["noun",["büyük","talih","kader","fırıldak çiçeği"]]],"ko":{"il":["devetabanı","çiçekli","lale","efelek","horozibiği","sütleğen","akdiken","çiçek","begonya","origami","akasya","güllü"],"ca":["felek","mezopotamya","kaside","panayır","bengal","zeybek","opera","mesnevi","portekizce"]},"z2":["bahtsızlık","bedbahtlık","cenup","güney","hoşlanmama","memat","mutsuzluk","sevmeme"]},"çarşamba pazarı":{"k":[["Her şeyi karmakarışık ortada olan yer","n",[],"",[],["yer"],[],[]]]},"denizli":{"k":[["Türkiye'nin Ege Bölgesi'nde yer alan illerinden biri","n",[],"",[],[],[],[]]],"ko":{"es":["balıkesir","nazilli","eskişehir"],"il":["muğla","kuşadası","izmir","tekirdağ","fethiye","karşıyaka","honaz","yenişehir","bursa","çanakkale","ege","kırklareli"],"ca":["brüksel","giresun","afyonkarahisar","helen","karabaş","gömeç","taklacı","düzce","akdoğan","ortopedi"]}},"dış merkezli":{"k":[["Bir elips ve hiperbolde, odaklar arasındaki uzaklığın büyük eksen uzunluğu ile olan oranla ilgili olan","a",["eksantrik"],"",[],[],[],[]]]},"diplomatik şekilde":{"k":[["Diplomatik bir biçimde","b",["diplomatik bir şekilde","diplomatikçe"],"",[],[],[],[]]]},"dölyatağı":{"k":[["Memelilerde dölün ana karnındayken içinde bulunduğu organ","n",["rahim","uterus","döl yatağı","ana rahmi","karın","hazne","oğulduruk","meşime"],"Karındaki çocuğun erkek mi, kız mı olduğu bilinmez.|Hamile kadın, karnındaki bebeğin hareket ettiğini hissetti.|Ultrason cihazı, anne karnındaki haznede geli…",[],["cinsel organ"],["kulunluk"],["testis","yumurtalık","meme başı","takım taklavat","üreme organları"]]],"m":[["noun",["memelilerde","rahim"]]],"ko":{"es":["rahim","uterus","dölüt"],"il":["farenks","yumurtalık","vajina","makat","pelvis","amniyon","vulva","anüs","plasenta","östaki","bronş","lenfa"],"ca":["hazne","hançere","artropod","azmak","emik","ümük","şom","meni","peritonit","primat"]}},"edebiyatçılık":{"k":[["Olay, düşünce, duygu ve hayallerin dil aracılığıyla sözlü veya yazılı olarak biçimlendirilmesi sanatı ile uğraşma işi","n",["yazıncılık"],"",[],["sanatçılık"],[],["ozanlık","portrecilik","arabeskçilik"]]],"m":[["noun",["yazıncılık"]]]},"elektronik beyin":{"k":[["Çok sayıda aritmetiksel veya mantıksal işlemlerden oluşan bir işi, önceden verilmiş bir programa göre yapıp sonuçlandıran elektronik araç","n",["bilgisayar"],"",[],["makine"],["çevrim içi","laptop","sunucu","dijital bilgisayar","web sitesi","minibilgisayar"],[]]],"m":[["noun",["bilgisayar"]]]},"evsahibi":{"k":[["","n",["ev sahibi"],"",[],["eldeci","mal sahibi"],[],["armatör"]],["İnsanları bir sosyal olaya davet eden kişi","n",[],"",[],["yetişkin insan"],[],["adam","bayan","erkek","şahsiyet","yaşlı","tuhaf kişi"]]]},"fakfon":{"k":[["Bakır, nikel ve çinkodan oluşan gümüş görünüşünde bir alaşım","n",[],"",[],["alaşım"],[],["alfenit","bakır alaşımı","dökme demir","lehim","amalgam","metal"]]],"m":[["noun",["bakır"]]],"mi":["bir küçük tabut tabakada gezdirirler ölüleri fakfon\nburunları çekmek üzre, ince çağrışımlıdır.","Ece Ayhan","Orta İkiden Ayrılan Çocuklar İçin Şiirler"]},"fırttırmak":{"k":[["Çılgınca davranışlarda bulunmak","v",["aklını oynatmak","deli çıkmak","aklı zıvanadan çıkmak","çıldırmak","zihnini oynatmak","tecennün etmek","kafayı üşütmek","kaçırmak","aklını kaçırmak","deli olmak","delirmek","çılgınlaşmak","cinnet geçirmek","mecnun olmak","esirmek","fıttırmak","üşütmek"],"Allah Allah, bu adam gittikçe aklını oynatıyor.|A a, ne yapıyor bu, çıldırmış mı ne?|Deli olmuş aşkından, garip garip davranışlarda bulunuyor.|İkramiye kazan…",[],["davranmak","dönüşmek"],[],["küstahlık etmek","hava atmak","terbiyesizlik etmek","soğuk davranmak","şartlara uymak"]]],"m":[["noun",["çıldırmak","delirmek","fıttırmak"]]]},"filistinli":{"k":[["Filistin halkından veya bu halkın soyundan olan kimse","n",[],"",[],["yerli"],[],[]]],"ko":{"es":["israilli","suriyeli"],"il":["afgan","lübnanlı","pakistanlı","somalili","afrikalı","yahudi","direnişçi","türkiyeli","amerikalı","müslüman","israil","ıraklı"],"ca":["sabıkalı","emekçi","emekli"]}},"gıllügiş":{"m":[["noun",["kin","gıllıgış"]]]},"gizil":{"k":[["Gizli kalmış, henüz varlığı ya da gücü ortaya çıkmamış olan","a",["potansiyel"],"Yüksekte tutulan bir taştaki gizil kuvvet, taş bırakılınca mekanik bir kuvvet halinde meydana çıkar.",[],[],[],[]]],"m":[["noun",["potansiyel"]]],"ko":{"il":["düşlemsel","edimsel","psişik","örtük","içrek","imgesel","tanrısal","içsel","tinsel","gizli","bilinçdışı","düşsel"],"ca":["potansiyel","doğaüstü","maddesel","başkalık","kamusal","özdek","geçişli","töz","tümel","bizatihi"]}},"gölek":{"k":[["Birikinti suların sulamak amacıyla genellikle bir set ardında toplandığı küçük göl","n",["gölet","gölcük","büğet","büvet","azmak","akmaz"],"Köyde su sıkıntısı yaşanmaması için dereye bir set çekilerek küçük bir gölet oluşturuldu.",[],["göl"],["karmık"],["artık göl","çöküntü gölü","dağ gölü","göl","krater gölü"]]],"m":[["noun",["gölcük","gölet"]]]},"güvenceli":{"k":[["Bir antlaşmada taraflardan birinin sorumluluğu üzerine almasını sağlayan","a",["garantili"],"Projedeki sorunların çözümünde garantili bir uzman olarak bilinen Ayşe, herkesin güvenini kazandı.",[],[],[],[]]],"m":[["noun",["garantili"]]],"ko":{"es":["garantili"],"il":["esnek","kaliteli","adil","sağlam","istikrarlı","onurlu","maliyetsiz","makul","verimli","etkin","adaletli","teminatlı"],"ca":["orijinalite","sebatkar","sosyalizasyon","yansızlık","insancıllık","irtibatsız","analitik","çözümsel","normatif","jandarmalık"]}},"hamaratlaşmak":{"k":[["Hamarat olmak","v",[],"",[],[],[],[]]]},"havsalasına sığmamak":{"k":[["Bir şeyin ne demek olduğunu, neye işaret ettiğini kavrayamamak","v",["aklı almamak"],"O kadar karmaşık konuşuyordu ki söyledikleri bir türlü havsalama sığmadı; anlamak için defalarca düşündüm.",[],[],[],[]],["Kabul edememek","v",["akıl erdirememek","akıl ermemek"],"Yollarda görülen manzara havsalaya sığmayacak kadar feciydi.|Küçücük bir çocuğa bu kadar sert davranıldığını görmek, insanın havsalasına sığmayacak bir durumdu.",[],[],[],[]]],"m":[["noun",["kavrayamamak"]]]},"hesapsız":{"k":[["Önceden iyi düşünülmemiş, sonu belli olmayan","a",["plansız"],"Şuurlu ve planlı geri çekilişler şuursuz ve plansız saldırışlardan çok daha dokunaklıdırlar.|Hesapsız adımlar atmadan önce iki kere düşünmelisin.|Plansız pro…",[],[],[],[]],["Aşırı ve yersiz harcamalar yapan","a",["müsrif","savruk","tutumsuz","savurganca","savurgan","idaresiz"],"Ay sonunu getiremeyen genç, babasının onu sürekli savruk olmakla suçlamasına aldırmıyordu.|Hesapsız arkadaşı sonunda borç batağına sürüklendi.",[],[],[],[]],["Hesabı tutulmayan","a",[],"",[],[],[],[]],["Sayılamayacak kadar çok olan","a",[],"",[],[],[],[]]],"m":[["noun",["ölçüsüz","tutumsuz","savruk","müsrif","çok","hesapsızca","plânsız"]]],"ko":{"es":["plansız","savurgan","savurganca"],"il":["kitapsız","ölçüsüz","azapsız","fütursuz","garazsız","karşılıksız","insafsız","hırssız","haramsız","riyasız","plansızca","nizamsız"],"ca":["halisane","canıgönülden","sakıngan","savruk","alakasızlık","namertlik","müsrif","arkadaşça","tutumsuz","içtenli