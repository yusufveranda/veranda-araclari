"lice","palu","mardin","kck"]}},"falez":{"k":[["Yüksek kıyılarda dalga aşındırmasıyla oluşan ve aşınma sürdükçe karanın içine doğru gerileyen yar","n",["yalı yar","yalıyar"],"",[],["uçurum"],[],["çal"]]],"m":[["noun",["yalı yar"]]],"ko":{"es":["yalıyar"],"il":["lagün","kumluca","kıyı","kumsal","kumul","kepez","iskele","finike","taraça","sahil","kayalık","düden"],"ca":["lahos"]}},"feragat göstermek":{"k":[["Hakkından vazgeçmek","v",["feragat etmek"],"",[],[],[],[]]]},"gelin hamamı":{"k":[["Evlenecek kız için düğünden birkaç gün önce hamamda yapılan tören","n",[],"",[],["tören"],[],[]],["Oğlanevindeki kadınların gelini düğünün ertesi günü hamama götürerek yaptıkları tören","n",[],"",[],["tören"],[],[]]]},"gizlenmiş":{"m":[["noun",["saklanmış","batuga","kamufle","mahf?uz","pinhan"]]]},"gönlün yazı var, kışı var":{"m":[["noun",["iyimser","kötümser","bezgin"]]]},"görevlenmek":{"k":[["Bir görevde bulunmak, bir görevi üstlenmek","v",["görev almak","hizmete girmek","geçmek","işe karışmak"],"Hâkimler ve savcılar kanunda belirtilenlerden başka resmî ve özel hiçbir görev alamazlar.|Bu projede geçmek için ekip arkadaşlarımın desteğine ihtiyacım var.…",[],[],[],[]]]},"göze çekirdeği ekşiti":{"m":[["noun",["nükleik asit"]]]},"gözünde":{"k":[["Bakılırsa, hesaba katılırsa, göz önünde tutulunca","b",["göre","bakarak","nazaran"],"Buna nazaran şimdi vereceğim malumat ve izahatı anlamak daha kolay olacaktır.",[],[],[],[]]],"m":[["noun",["nazarında","indinde"]]],"ko":{"es":["nazarında"],"il":["yanında","gözde","nezdinde","gözbebeği","beyninde","adeta","kendinde","daima"],"ca":["sönük","hor","öylece","umarsız","şaşılık","dalgın","orası","sende","daim","gözyaşı"]},"mi":["beri sağlamış bulunduğu yer, okurun gözünde de matematik bir kesinlik kazandı.\nSanırım, bu yer, bundan sonra en az tartışılır yerlerden biri olarak kalacaktır.","Ahmed Arif","Ahmed Arif"]},"güney doğu asya":{"k":[["Asya kıtasıyla Okyanusya arasında bulunan, Çin'in güneyinde, Hindistan'ın doğusunda, Yeni Gine'nin batısınd