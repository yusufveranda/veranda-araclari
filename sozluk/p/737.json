ım zaman o muammayı halletti .|Bu işi de kıvırdın, helal olsun.|Bu işi kotarabileceğine ben canı …",["başarısız olmak","eli boş çıkmak","başarısızlığa uğramak","becerememek"],[],["ortasını bulmak"],[]],["Bir iş yapmaya alışmış olmak, gücü yetmek","v",["elinden gelmek","bilmek","gücü yetmek","eli ermek","baş gelmek","ulaşabilmek","hükmü geçmek","hüküm yürütmek","muktedir olmak"],"Nesir az çok benim de elimden geldiği için midir nedir kabul edemiyorum şiirden güç olduğunu.",[],[],[],[]]],"z2":["akamete uğramak","başaramamak","başarısız olmak","başarısızlığa uğramak","bırakmak","eli boş çıkmak","eli böğründe kalmak","eline yüzüne bulaştırmak"]},"başoluşmak":{"m":[["noun",["başlanmak"]]]},"batağa saplanmak":{"k":[["İçinden çıkılması güç bir durumda olmak","v",[],"",[],[],[],[]]]},"birleşik tümce":{"k":[["Bir veya birkaç yan cümle veya ara cümle ile bir temel cümleden kurulan cümle","n",["birleşik cümle","bileşik cümle"],"",[],["cümle"],[],[]]]},"biyolojik":{"k":[["Biyoloji ile ilgili, hayatla ilgili","a",["dirimsel","dirim bilimsel","dirimlik","hayati"],"Bilim insanları, suyun varlığını bir gezegende yaşamın temel bir işareti olarak gördükleri için bu keşfi hayati bir öneme sahip biyolojik bir bulgu olarak de…",[],[],[],[]]],"m":[["noun",["dirimsel","dirimbilimsel","dirim bilimsel","soysuzlaşmak"]]],"ko":{"es":["fizyolojik","kimyasal","genetik","toksikolojik","ekolojik","fiziksel","etolojik","immünolojik","mikrobiyolojik","çevresel"],"il":["bakteriyolojik","moleküler","sosyolojik","embriyolojik","farmakolojik","hormonal","psikolojik","antropolojik","morfolojik","mekanik","minerolojik","teknolojik"],"ca":["kimya","fizik","ilkel","oluşum","coğrafya","parazit","gelişim","endüstri","etkileşim","küresel"]}},"bohçacı kadın":{"k":[["Gezerek bohça içinde dokuma eşya satan kadın","n",["bohçacı","basmacı"],"Bir bohçacı kadın gelmiş, beni sormuş, görmek istemiş.",[],["satıcı"],[],[]]]},"bok böceği":{"k":[["Kın kanatlılardan, genellikle otçul memeli hayvanların gübrelerinde yaşayan