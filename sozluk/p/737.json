,[]],["Seçkin, seçilmiş, seçme","a",["güzide"],"Gece yüzüne yaptığı makyaj değme ustaların işiydi.|Güzide öğrenciler, bu yılki ödül törenine katılmaya hak kazandılar.",[],[],[],[]],["Her; herhangi bir; gelişigüzel; rastgele","a",[],"",[],[],[],[]]],"m":[["noun",["temas","her","gelişigüzel","rastgele","seçkin","seçme","ittisal","kontak","teğme"]]],"um":[["Güneş değmemiş mermer gibi sade\nKadim deniz nerde?","Zylphia ve Qfwfq","https://www.birgunkarayigormekuzere.net/poems/zylphia-ve-qfwfq"],["Aklımda bir türkü kulağına değmesin gürültü diye\nAl beni, cismimi, hatıra diye ve öldür","Sadaka","https://www.birgunkarayigormekuzere.net/poems/sadaka"]]},"diyagonal":{"k":[["Bir çokgende ardışık olmayan veya birçok yüzlüde aynı düzlem üzerinde bulunmayan iki köşe arasına çekilen çizgi","n",["köşegen","kutur"],"Sekizgenin karşıt köşelerini birleştiren kutur çizgisi dikkatlice ölçüldü.",[],["düz çizgi"],[],["dikme","bordür","çap","çubuk","doğru","kiriş"]],["Eğri bir biçimde dokunmuş kumaş","n",[],"",[],["kumaş"],[],[]]],"m":[["noun",["köşegen","çapraz"]]],"ko":{"es":["köşegen"],"il":["düşey","dairesel","kavisli","dikey","doğrusal","dikdörtgensel","çapraz","çaprazvari","lineer","simetrik","çizgisel","uzunlamasına"],"ca":["iletki","konkav","asimetrik","arkalık","paylı","varsayımlı"]}},"duygun":{"k":[["Bir olay, bir görünüm karşısında hızlı ve kolayca güçlü duyguların etkisinde kalan","a",["hassas","duygulu","duyar","hisli","santimantal","içli","inceden","rebabi"],"İçli çocuk|Doğum gününde aldığı küçük bir not bile gözlerinin dolmasına yetti; çok hassas biriydi.",["duyarsız"],[],[],[]]],"m":[["noun",["duygulu","duyar","hassas"]]],"ko":{"il":["düşüncel","düşüncelilik","kanaatkarlık","minnettarlık","kanaatkârlık","üzgünlük","hırssız","naziklik","üzüntüsüz","arzusuz","gücenik","insancıllık"],"ca":["hisli","patetik","acımsı","hiddetli","sünepe","patırtılı","katışık","hınçlı","nevrotik","narin"]}},"eğri bakmak":{"k":[["Kötü düşünce ile bakmak","v",["eğri gözle bakmak"],"Komşusu , ağlay