{"w":{"ablatya":{"k":[["Uzunluğu 150, genişliği 4-10 kulaç olan, geniş gözlü bir balık ağı","n",[],"",[],["balık ağı"],[],[]]]},"adamlığa":{"m":[["noun",["adam gibi"]]]},"ağırdan almak":{"k":[["Çok nazlı davranmak","v",["kendini dirhem dirhem satmak"],"Görüyorsunuz ki bu soyadı konusunda benim ağırdan alışım, bir tembellik değil.|Her isteğe hemen evet demiyor, kendini dirhem dirhem satıyor.",[],["geç kalmak"],["sürüncemede bırakmak"],["sürüncemede bırakmak","ertelemek"]]],"m":[["noun",["geciktirmek"]]]},"ağzına etmek":{"k":[["Birinin bir konudaki ters tutumunu sert bir karşılıkla düzeltmek","v",["yola getirmek","haddini bildirmek","hizaya getirmek","ıslah etmek","kuyruğunu tava sapına çevirmek","mum etmek","muma çevirmek","muma döndürmek","tedip etmek","uslandırmak"],"Patron, dikkatsiz çalışanlarını sert bir konuşmayla hizaya getirdi.|Toplantıda saygısızca konuşan çalışana müdür, kesin bir üslupla haddini bildirip düzeni s…",[],[],[],[]]]},"aksiyon":{"k":[["Durağan bir noktaya göre devinmekte olan bir nesnenin durumu; devim; hareket","n",["devinim","devinme","eylem","hareket"],"Dünya'nın biri kendi, öteki Güneş çevresinde olmak üzere iki devinimi vardır.|Trenin sürekli bir hareket halindeydi.",[],["olay"],["aborda","açık düşme","adalet","akım","aksiyon","amel"],[]],["Oyunun temasını geliştiren başlıca olay; hikâye","n",["gelişim"],"Hikâyenin gelişiminde, kahramanın içsel çatışmaları ve yeni tanıştığı karakterler büyük rol oynadı.",[],["yer değişikliği"],[],[]],["Anonim veya komandit ortaklıklarda, ortaklık sermayesinin birbirine eşit bölümlere ayrılmış parçasından her birinin karşılığı olmak üzere, yasada gösterilen özelliklere uygun olarak düzenlenmiş değ…","n",["hisse senedi","pay senedi","belgit"],"Borsa uzmanı, yeni yatırımcıya hisse senetlerinin işleyişini anlattı.",[],["kağıt","menkul kıymetler"],[],["borsa kağıdı","vergi muafiyeti"]],["Bir kuvvetin, maddi bir etkenin, bir düşüncenin ortaya çıkması","n",[],"",[],["devinim"],["başarı","şiddet","değişim","tasarr