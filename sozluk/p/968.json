ı","holding","yanıltmaca","provokatör","baloncu","hizmetkâr"]}},"yalaka":{"k":[["Can sıktığına, rahatsız ettiğine aldırmadan bir kimseden sürekli, yalvarırcasına istekte bulunan ve bu isteğinde direnen kimse","a",["bulaşık","sırnaşık","yapışkan","muacciz"],"Ne yapışkan adam, bir türlü savamadık.|Sokakta sırnaşık bir çocuk, turistlere sürekli mendil satmaya çalışıyordu.",[],[],[],[]],["Kendisine çıkar sağlayacak olanlara aşırı bir saygı ve hayranlık göstererek yaranmak isteyen kimse; yağcı","a",["dalkavuk","çanak yalayıcı","huluskâr","huluskar"],"İhsan bekleyen bu çanak yalayıcı, bu jurnalci yaratıklar köpeklik tarihinin yüz karası idiler.",[],[],[],[]]],"m":[["noun",["dalkavuk","arsız","sırnaşık","yardakçı"]]],"ko":{"es":["şakşakçı","dalkavuk","goygoycu","yandaş","liboş"],"il":["şaklaban","candaş","karaktersiz","yağcı","çomar","iftiracı","müptezel","yağcılık","dangalak","menfaatçi","soytarı","şerefsiz"],"ca":["partizan","mendebur","samani","hayasız","hayâsız","kabiliyetsiz","ahlakçılık","türkçülük","sahtekar","sünepe"]}},"yarı ünlü":{"m":[["noun",["ğ","yarım vokal"]]]},"yaşam dolu":{"k":[["Yaşama isteği çok olan, hareketli","a",["canlı","hayat dolu","ruhlu"],"Küçük kız, enerjik ve canlı haliyle etrafına neşe saçıyordu.|O, gerçekten ruhlu bir insandı; her anı dolu dolu yaşar, etrafındaki herkese neşe saçardı.",[],[],[],[]]],"z2":["cansız","geberik","soluk","sönük","sünepe","ölmüş","ölü"]},"yaşını sürmek":{"k":[["... yaşında olmak","v",[],"",[],[],[],[]]]},"yükte hafif, pahada ağır":{"m":[["noun",["değerli","takı"]]]},"yüzünü güldürmek":{"k":[["Birini mutlu etmek, birine iyilik etmek","v",[],"",[],[],[],[]]]},"zarkanatlılardan":{"m":[["noun",["arı","balarısı","kırmızböceği"]]]},"zevklenme":{"m":[["noun",["haz"]]]}},"r":{"meclis":["divan","kurul","heyet","encümen","toplantı","oturum","cemiyet","parlamento","kamutay","bezm","işret meclisi","muhabbet","konsey","şura","şûra","gündem","iç tüzük","kanat","önerge","tatil","tutanak"],"müşahhas":["abstre","mücerret","somut","k