yasi coğrafya","tarihi coğrafya"]]]},"ümidini kesmek":{"k":[["Artık olacağını beklememek, güveni sarsılmak, olumsuzluğa sürüklenmek","v",["umutsuzluğa kapılmak","umudunu kesmek","umutsuzluğa düşmek","umut kesmek","ümitsizliğe düşmek","karamsar olmak","içi kararmak","göz yummak","bedbin olmak"],"Aradan dört beş yıl geçince bir yerden de haber gelmeyince sağlığından umutlarını kesmişler.|Defalarca verilen sözlerin tutulmamasından sonra projenin başarı…",[],[],[],[]]]},"ümit bırakmak":{"k":[["Davranışıyla, tutumuyla bir işi yapacağı duygusunu uyandırmak, bir kimseye güven vermek","v",["ümit vermek","umut vermek","vadetmek","umut vadetmek","umut bırakmak"],"Cemil'in bu sözleri kalplerde hiç olmazsa yarın için biraz ümit bırakıyordu.",[],["mümkün görünmek"],[],["müsait olmak"]]]},"yağlı ballı olmak":{"k":[["Karşılıklı olarak candan ve içten davranmak, birbirinden hiçbir şey esirgemeyecek durumda olmak","v",["içli dışlı olmak","samimi olmak","ayrısı gayrısı olmamak"],"Toprakla insan hiçbir edebiyatta böylesine içli dışlı değildir.|Arkadaşlarıyla samimi olmak, ona gerçek anlamda mutluluk veriyordu.|Arkadaşlarıyla samimî olm…",[],[],[],[]]]},"yaklaştırım":{"k":[["Yaklaştırmak eylemi, yaklaştırma","n",[],"",[],["iş"],[],[]]]},"yelken":{"k":[["Rüzgar gücünden faydalanıp yol almak üzere direklerine kalın bez gerilen su aracı","n",["yelkenli","yelkenli tekne"],"Yelken yarışları.",[],["gemi","tekne"],["brik","çırnık","gagaburun","kotra","Latin yelkeni","şalupa"],[]],["Rüzgâr gücünden yararlanarak geniş bir yüzey oluşturacak biçimde yan yana dikilen ve teknenin direğine uygun bir biçimde takılarak onu hareket ettiren kumaş veya şeritlerin tümü","n",[],"",[],["kumaş parçası"],["flok","gabya yelkeni","mayistra","pik","randa"],[]]],"m":[["noun",["yelkenli"]]],"ko":{"il":["tekne","kürek","dümensiz","dalış","kayık","katamaran","teknecilik","yatçılık","kano","dümen","paraşüt","gemi"],"ca":["güverte","iskele","seren","ahşap","borda","halat","bisiklet","buz","tekerlek","rıhtım"]},"um":[[